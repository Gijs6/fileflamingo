{% extends "skeleton.jinja" %}

{% block body_content %}
    <header class="navbar">
        <div class="navbar__inner">
            <a href="{{ url_for('admin.dashboard') }}" class="navbar__brand">{% include "mark.svg" %}FileFlamingo</a>
            <nav class="navbar__links" aria-label="Admin">
                <a href="{{ url_for('admin.dashboard') }}"
                   {% if request.blueprint == "admin" %}aria-current="page"{% endif %}>Transfers</a>
                <a href="{{ url_for('transfers.index') }}">View site</a>
                <form method="post" action="{{ url_for('admin.logout') }}">
                    <button type="submit">Sign out</button>
                </form>
            </nav>
        </div>
    </header>

    <main class="page">
        {% block content %}{% endblock %}
    </main>
{% endblock %}
