{% extends "skeleton.jinja" %}

{% from "_macros.jinja" import icon %}

{% block body_class %}page page--topnav page--wide{% endblock %}

{% block body_content %}
    <header class="app-bar">
        <a href="{{ url_for('admin.dashboard') }}" class="wordmark">
            <span class="wordmark__mark">{{ icon("bird") }}</span>
            <span class="wordmark__text">FileFlamingo</span>
        </a>

        <nav class="app-bar__nav" aria-label="Admin">
            <a href="{{ url_for('admin.dashboard') }}"
               {% if request.blueprint == "admin" %}aria-current="page"{% endif %}>Transfers</a>
        </nav>

        <div class="app-bar__actions">
            <a href="{{ url_for('transfers.index') }}" class="button button--ghost">{{ icon("external-link") }} View site</a>
            <form method="post" action="{{ url_for('admin.logout') }}">
                <button type="submit" class="button button--ghost">{{ icon("log-out") }} Sign out</button>
            </form>
        </div>
    </header>

    <main class="page__main">
        {% block content %}{% endblock %}
    </main>
{% endblock %}
