{% extends "skeleton.jinja" %}

{% block body_content %}
    <header class="navbar">
        <div class="navbar__inner">
            <a href="{{ url_for('transfers.index') }}" class="navbar__brand">{% include "mark.svg" %}FileFlamingo</a>
            <nav class="navbar__links" aria-label="Main">
                <a href="{{ url_for('admin.dashboard') }}"
                   {% if request.blueprint == "admin" %}aria-current="page"{% endif %}>Transfers</a>
                <a href="{{ url_for('transfers.index') }}">View site</a>
                {% if auth_provider == "password" %}
                    <form method="post" action="{{ url_for('auth.logout') }}">
                        <button type="submit">Sign out</button>
                    </form>
                {% endif %}
            </nav>
        </div>
    </header>

    <main class="page">
        {% block content %}{% endblock %}
    </main>
{% endblock %}
