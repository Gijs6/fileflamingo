<!DOCTYPE html>
<html lang="en-GB">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>{%- block title -%}{%- endblock %} - FileFlamingo</title>
        <meta name="description" content="Share files with a link." />
        <meta name="theme-color"
              content="#c2255c"
              media="(prefers-color-scheme: light)" />
        <meta name="theme-color"
              content="#ab2956"
              media="(prefers-color-scheme: dark)" />

        <link rel="icon"
              href="{{ url_for('static', filename='favicon.svg') }}"
              type="image/svg+xml" />
        <link rel="alternate icon"
              href="{{ url_for('static', filename='favicon.ico') }}" />

        {% set theme = "http://localhost:8000/theme/v2" if config.DEBUG else "https://cdn.gijs6.nl/theme/v2" %}
        <link rel="stylesheet" href="{{ theme }}/all.css" />
        <link rel="stylesheet" href="{{ theme }}/accent/pink.css" />
        {% if config.DEBUG %}
            <link rel="stylesheet"
                  href="{{ url_for('static', filename='styles/app.css') }}" />
        {% else %}
            <link rel="stylesheet"
                  href="{{ url_for('static', filename='styles/app.min.css') }}" />
        {% endif %}

        <script src="{{ url_for('static', filename='vendor/htmx.min.js') }}" defer></script>
        <script src="{{ theme }}/js/toast.js" defer></script>

        {% block extra_headers %}{% endblock %}
    </head>

    <body class="app {% block body_class %}{% endblock %}">
        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                <div class="toaster" aria-live="polite">
                    {% for category, message in messages %}
                        {% set kind = "success" if category == "success" else "danger" if category == "error" else "info" %}
                        <div class="toast toast--{{ kind }}"
                             role="status"
                             data-auto-dismiss="6000">
                            <div class="toast__body">{{ message }}</div>
                            <button type="button" class="toast__dismiss" aria-label="Dismiss">&times;</button>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% endwith %}

        {% block body_content %}{% endblock %}

        <script>
            const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

            function localTimes() {
                const pad = (n) => String(n).padStart(2, '0');
                document.querySelectorAll('time[data-local]').forEach(function(el) {
                    const dt = new Date(el.getAttribute('datetime'));
                    if (isNaN(dt)) return;
                    el.textContent = dt.getDate() + ' ' + MONTHS[dt.getMonth()] + ' ' + dt.getFullYear() + ', ' + pad(dt.getHours()) + ':' + pad(dt.getMinutes());
                });
            }
            localTimes();
            document.addEventListener('htmx:afterSettle', localTimes);
        </script>
    </body>
</html>
