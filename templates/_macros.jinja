{% macro steps(current) -%}
    {%- set names = ["Upload", "Message", "Options", "Done"] -%}
    <ol class="steps" aria-label="Progress">
        {% for name in names %}
            <li class="steps__item{% if loop.index < current %} steps__item--done{% elif loop.index == current %} steps__item--current{% endif %}"
                {% if loop.index == current %}aria-current="step"{% endif %}>{{ loop.index }}. {{ name }}</li>
        {% endfor %}
    </ol>
{%- endmacro %}
