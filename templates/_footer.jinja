<footer class="footer">
    <div class="footer__inner">
        {% if request.blueprint == "admin" %}
            <p class="footer__version">{{ APP_VERSION }}</p>
        {% else %}
            <p>
                <a href="{{ url_for('transfers.index') }}" class="footer__app">{% include "mark.svg" %}FileFlamingo</a> <span class="footer__version">({{ APP_VERSION }})</span> by <a href="https://gijs6.nl">Gijs6</a>
            </p>
            <p>
                <a href="https://unlicense.org" rel="license">Unlicensed</a>
            </p>
        {% endif %}
    </div>
</footer>
