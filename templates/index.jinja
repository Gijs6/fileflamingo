{% extends "site_base.jinja" %}

{% from "_macros.jinja" import steps %}

{% block title %}Share files{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Share files</h1>
    </div>

    <p class="lead">Upload files and get a link to share with anyone.</p>

    {{ steps(1) }}

    <form method="post"
          action="{{ url_for('transfers.create') }}"
          enctype="multipart/form-data"
          hx-post="{{ url_for('transfers.create') }}"
          hx-encoding="multipart/form-data"
          hx-swap="none"
          hx-disabled-elt="#submit-btn">
        <fieldset class="file-drop-set">
            <legend class="visually-hidden">Select files to upload</legend>

            <label class="file-drop" id="dropzone">
                <input type="file" name="files[]" id="files" multiple />
                <span class="file-drop__primary" id="dropzone-primary">Drop files here or browse</span>
            </label>

            <table class="table file-table" id="file-table" hidden>
                <thead>
                    <tr>
                        <th scope="col">File</th>
                        <th scope="col" class="table__num">Size</th>
                        <th scope="col" class="table__actions">
                            <span class="visually-hidden">Actions</span>
                        </th>
                    </tr>
                </thead>
                <tbody id="file-list" aria-live="polite">
                </tbody>
            </table>

            <template id="file-row">
                <tr>
                    <td class="file-table__name"></td>
                    <td class="table__num file-table__size"></td>
                    <td class="table__actions">
                        <button type="button" class="btn btn--sm file-table__remove">Remove</button>
                    </td>
                </tr>
            </template>
        </fieldset>

        <div class="meter" id="upload-progress" hidden>
            <p class="meter__label" id="upload-progress-label">Uploading</p>
            <div class="meter__track">
                <div class="meter__fill" id="upload-progress-fill"></div>
            </div>
        </div>

        <div class="form__actions">
            <button type="submit" class="btn" id="submit-btn" disabled>Continue</button>
        </div>
    </form>

    <script src="{{ url_for('static', filename='scripts/upload.js') }}"></script>
{% endblock %}
