{% extends "site_base.jinja" %}

{% from "_macros.jinja" import icon, steps %}

{% block title %}Share files{% endblock %}

{% block content %}
    <div class="page-head">
        <div>
            <h1>Share files</h1>
            <p class="lead">Upload files and get a link to share with anyone.</p>
        </div>
    </div>

    {{ steps(1) }}

    <form class="form"
          method="post"
          action="{{ url_for('transfers.create') }}"
          enctype="multipart/form-data"
          hx-post="{{ url_for('transfers.create') }}"
          hx-encoding="multipart/form-data"
          hx-disabled-elt="#submit-btn">
        <fieldset class="form__section">
            <legend class="visually-hidden">Select files to upload</legend>

            <label class="file-drop" id="dropzone">
                <input type="file" name="files[]" id="files" multiple />
                {{ icon('upload', 'file-drop__icon') }}
                <span class="file-drop__primary" id="dropzone-primary">Drop files here or browse</span>
                <span class="file-drop__hint" id="dropzone-hint">Any file type, up to the server limit</span>
            </label>

            <ul class="file-list" id="file-list" aria-live="polite">
            </ul>

            <template id="file-row">
                <li class="file-list__item">
                    {{ icon('file', 'file-list__icon') }}
                    <span class="file-list__name"></span>
                    <span class="file-list__size"></span>
                </li>
            </template>
        </fieldset>

        <div class="meter" id="upload-progress" hidden>
            <div class="meter__head">
                <span id="upload-progress-label">Uploading</span>
            </div>
            <div class="meter__track">
                <div class="meter__fill" id="upload-progress-fill"></div>
            </div>
        </div>

        <div class="form__actions form__actions--end">
            <button type="submit" class="button" id="submit-btn" disabled>Continue {{ icon("arrow-right") }}</button>
        </div>
    </form>

    <script>
        (function() {
            const dropzone = document.getElementById('dropzone');
            const input = document.getElementById('files');
            const list = document.getElementById('file-list');
            const btn = document.getElementById('submit-btn');
            const primary = document.getElementById('dropzone-primary');
            const hint = document.getElementById('dropzone-hint');
            const rowTemplate = document.getElementById('file-row');

            let files = [];

            function fmt(b) {
                if (b < 1024) return b + ' B';
                if (b < 1048576) return (b / 1024).toFixed(1) + ' KB';
                if (b < 1073741824) return (b / 1048576).toFixed(1) + ' MB';
                return (b / 1073741824).toFixed(1) + ' GB';
            }

            function syncInput() {
                const dt = new DataTransfer();
                files.forEach(function(f) {
                    dt.items.add(f);
                });
                input.files = dt.files;
            }

            function addFiles(incoming) {
                Array.from(incoming).forEach(function(f) {
                    if (!files.some(function(e) {
                            return e.name === f.name && e.size === f.size;
                        })) {
                        files.push(f);
                    }
                });
                syncInput();
                render();
            }

            function render() {
                var hasFiles = files.length > 0;

                list.innerHTML = '';
                files.forEach(function(f) {
                    var li = rowTemplate.content.firstElementChild.cloneNode(true);
                    li.querySelector('.file-list__name').textContent = f.name;
                    li.querySelector('.file-list__size').textContent = fmt(f.size);
                    list.appendChild(li);
                });

                btn.disabled = !hasFiles;

                if (hasFiles) {
                    primary.textContent = files.length === 1 ? '1 file selected' : files.length + ' files selected';
                    hint.textContent = 'Click to add more';
                } else {
                    primary.textContent = 'Drop files here or browse';
                    hint.textContent = 'Any file type, up to the server limit';
                }
            }

            input.addEventListener('change', function() {
                addFiles(input.files);
            });

            dropzone.addEventListener('dragover', function(e) {
                e.preventDefault();
                dropzone.classList.add('is-dragover');
            });
            dropzone.addEventListener('dragleave', function(e) {
                if (!dropzone.contains(e.relatedTarget)) {
                    dropzone.classList.remove('is-dragover');
                }
            });
            dropzone.addEventListener('drop', function(e) {
                e.preventDefault();
                dropzone.classList.remove('is-dragover');
                addFiles(e.dataTransfer.files);
            });

            var form = btn.closest('form');
            var progressEl = document.getElementById('upload-progress');
            var progressFill = document.getElementById('upload-progress-fill');
            var progressLabel = document.getElementById('upload-progress-label');

            form.addEventListener('htmx:beforeRequest', function() {
                progressFill.style.setProperty('--meter', '0%');
                progressLabel.textContent = 'Uploading';
                progressEl.hidden = false;
            });

            form.addEventListener('htmx:beforeSend', function(e) {
                e.detail.xhr.upload.addEventListener('progress', function(ev) {
                    if (!ev.lengthComputable) return;
                    var pct = Math.round((ev.loaded / ev.total) * 100);
                    progressFill.style.setProperty('--meter', pct + '%');
                    progressLabel.textContent = pct < 100 ? pct + '%' : 'Processing';
                });
            });

            form.addEventListener('htmx:afterRequest', function() {
                progressEl.hidden = true;
            });
        })();
    </script>
{% endblock %}
