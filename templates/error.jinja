{% extends "skeleton.jinja" %}

{% from "_macros.jinja" import icon %}

{% block title %}{{ code }} {{ title }}{% endblock %}
{% block body_class %}page page--bare{% endblock %}

{% block body_content %}
    <main class="page__main">
        <p class="error__code">{{ code }}</p>
        <h1>{{ title }}</h1>
        <p class="lead">
            {% if code == 404 %}
                This page or transfer does not exist.
            {% elif code == 410 %}
                This transfer has expired and its files have been removed.
            {% elif code == 413 %}
                The uploaded file exceeds the maximum allowed size.
            {% else %}
                Something went wrong.
            {% endif %}
        </p>
        <a href="{{ url_for('transfers.index') }}" class="button">{{ icon("bird") }} Go home</a>
    </main>
{% endblock %}
