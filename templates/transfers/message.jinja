{% extends "site_base.jinja" %}

{% from "_macros.jinja" import steps %}

{% block title %}Add a message{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Add a message</h1>
    </div>

    {{ steps(2) }}

    <table class="table">
        <thead>
            <tr>
                <th scope="col">File</th>
                <th scope="col" class="table__num">Size</th>
            </tr>
        </thead>
        <tbody>
            {% for f in transfer.files %}
                <tr>
                    <td class="file-table__name">{{ f.filename }}</td>
                    <td class="table__num">{{ f.size | filesize }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <form method="post"
          action="{{ url_for('transfers.save_message', transfer_id=transfer.id) }}"
          hx-patch="{{ url_for('transfers.save_message', transfer_id=transfer.id) }}">
        <input type="hidden" name="_method" value="PATCH" />

        <div class="field">
            <label class="field__label" for="message">
                Message <span class="field__optional">(optional)</span>
            </label>
            <textarea name="message"
                      id="message"
                      rows="4"
                      placeholder="Add a note for the recipient">{{ transfer.message or '' }}</textarea>
        </div>

        <div class="field">
            <label class="field__label" for="email">
                Send link to email <span class="field__optional">(optional)</span>
            </label>
            <input type="email"
                   name="email"
                   id="email"
                   value="{{ transfer.recipient_email or '' }}"
                   placeholder="recipient@example.com" />
        </div>

        <div class="form__actions">
            <a href="{{ url_for('transfers.index') }}" class="btn">Back</a>
            <button type="submit" class="btn" id="continue-btn" hidden>Continue</button>
            <a href="{{ url_for('transfers.details', transfer_id=transfer.id) }}"
               class="btn"
               id="skip-btn">Skip</a>
        </div>
    </form>

    <script>
        (function() {
            const messageField = document.getElementById('message');
            const emailField = document.getElementById('email');
            const continueBtn = document.getElementById('continue-btn');
            const skipBtn = document.getElementById('skip-btn');

            function update() {
                const filled = messageField.value.trim() !== '' || emailField.value.trim() !== '';
                continueBtn.hidden = !filled;
                skipBtn.hidden = filled;
            }

            messageField.addEventListener('input', update);
            emailField.addEventListener('input', update);
            update();
        })();
    </script>
{% endblock %}
