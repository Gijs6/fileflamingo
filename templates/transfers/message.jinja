{% extends "site_base.jinja" %}

{% from "_macros.jinja" import steps %}

{% block title %}Add a message{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Add a message</h1>
    </div>

    {{ steps(2) }}

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">File</th>
                    <th scope="col" class="table__num">Size</th>
                </tr>
            </thead>
            <tbody>
                {% for f in transfer.files %}
                    <tr>
                        <td class="file-table__name">{{ f.filename }}</td>
                        <td class="table__num">{{ f.size | filesize }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <form method="post"
          action="{{ url_for('transfers.save_message', transfer_id=transfer.id) }}"
          hx-patch="{{ url_for('transfers.save_message', transfer_id=transfer.id) }}">
        <input type="hidden" name="_method" value="PATCH" />

        <div class="field">
            <label class="field__label" for="message">
                Message <span class="field__optional">(optional)</span>
            </label>
            <textarea name="message"
                      id="message"
                      rows="4"
                      placeholder="Add a note for the recipient">{{ transfer.message or '' }}</textarea>
        </div>

        <div class="form__actions">
            <button type="submit" form="cancel-transfer" class="btn">Cancel</button>
            <button type="submit" class="btn" id="continue-btn" hidden>Continue</button>
            <a href="{{ url_for('transfers.details', transfer_id=transfer.id) }}"
               class="btn"
               id="skip-btn">Skip</a>
        </div>
    </form>

    <form id="cancel-transfer"
          method="post"
          action="{{ url_for('transfers.cancel', transfer_id=transfer.id) }}"
          data-confirm="Cancel this upload? The uploaded files are deleted."
          data-confirm-action="Cancel upload">
    </form>

    <script src="{{ url_for('static', filename='scripts/message.js') }}"></script>
{% endblock %}
