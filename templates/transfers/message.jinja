{% extends "site_base.jinja" %}

{% from "_macros.jinja" import icon, steps %}

{% block title %}Add a message{% endblock %}

{% block content %}
    <div class="page-head">
        <div>
            <h1>Add a message</h1>
            <p class="lead">Optionally attach a note and send the link by email.</p>
        </div>
    </div>

    {{ steps(2) }}

    <ul class="file-list">
        {% for f in transfer.files %}
            <li class="file-list__item">
                {{ icon(f.mime_type | file_icon, "file-list__icon") }}
                <span class="file-list__name">{{ f.filename }}</span>
                <span class="file-list__size">{{ f.size | filesize }}</span>
            </li>
        {% endfor %}
    </ul>

    <form class="form"
          method="post"
          action="{{ url_for('transfers.save_message', transfer_id=transfer.id) }}"
          hx-patch="{{ url_for('transfers.save_message', transfer_id=transfer.id) }}">
        <input type="hidden" name="_method" value="PATCH" />

        <div class="field">
            <label class="field__label field__label--optional" for="message">Message</label>
            <textarea class="field__control field__control--full"
                      name="message"
                      id="message"
                      rows="4"
                      placeholder="Add a note for the recipient">{{ transfer.message or '' }}</textarea>
        </div>

        <div class="field">
            <label class="field__label field__label--optional" for="email">Send link to email</label>
            <input class="field__control field__control--full"
                   type="email"
                   name="email"
                   id="email"
                   value="{{ transfer.recipient_email or '' }}"
                   placeholder="recipient@example.com" />
        </div>

        <div class="form__actions form__actions--split">
            <a href="{{ url_for('transfers.index') }}" class="button button--ghost">{{ icon("arrow-left") }} Back</a>
            <button type="submit" class="button" id="continue-btn" hidden>Continue {{ icon("arrow-right") }}</button>
            <a href="{{ url_for('transfers.details', transfer_id=transfer.id) }}"
               class="button button--ghost"
               id="skip-btn">Skip</a>
        </div>
    </form>

    <script>
        (function() {
            const messageField = document.getElementById('message');
            const emailField = document.getElementById('email');
            const continueBtn = document.getElementById('continue-btn');
            const skipBtn = document.getElementById('skip-btn');

            function update() {
                const filled = messageField.value.trim() !== '' || emailField.value.trim() !== '';
                continueBtn.hidden = !filled;
                skipBtn.hidden = filled;
            }

            messageField.addEventListener('input', update);
            emailField.addEventListener('input', update);
            update();
        })();
    </script>
{% endblock %}
