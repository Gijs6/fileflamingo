{% extends "site_base.jinja" %}

{% from "_macros.jinja" import steps %}

{% block title %}Options{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Options</h1>
    </div>

    {{ steps(3) }}

    <form method="post"
          action="{{ url_for('transfers.configure', transfer_id=transfer.id) }}"
          hx-patch="{{ url_for('transfers.configure', transfer_id=transfer.id) }}">
        <input type="hidden" name="_method" value="PATCH" />

        <div class="field field--narrow">
            <label class="field__label" for="expiry">Link expires after</label>
            <select name="expiry" id="expiry">
                <option value="1">1 day</option>
                <option value="7" selected>7 days</option>
                <option value="30">30 days</option>
                <option value="0">Never</option>
            </select>
        </div>

        <div class="form__actions">
            <a href="{{ url_for('transfers.message', transfer_id=transfer.id) }}"
               class="btn">Back</a>
            <button type="submit" class="btn">Create link</button>
        </div>
    </form>
{% endblock %}
