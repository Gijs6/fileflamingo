{% extends "site_base.jinja" %}

{% from "_macros.jinja" import steps, when %}

{% block title %}Ready to share{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Ready to share</h1>
    </div>

    {{ steps(4) }}

    {% if transfer.recipient_email %}<p class="lead">Link sent to {{ transfer.recipient_email }}.</p>{% endif %}

    <div class="input-row">
        <input type="text"
               id="link-url"
               value="{{ download_url }}"
               readonly
               aria-label="Shareable download link" />
        <button type="button" class="btn" id="copy-btn">Copy link</button>
    </div>

    <div class="table-wrap">
        <table class="table table--kv table--fit">
            <caption class="visually-hidden">Details</caption>
            <tbody>
                <tr>
                    <th scope="row">Files</th>
                    <td>{{ transfer.files | length }}</td>
                    <th scope="row">Size</th>
                    <td>{{ transfer.total_size | filesize }}</td>
                    <th scope="row">Expires</th>
                    <td>
                        {% if transfer.expires_at %}
                            {{ when(transfer.expires_at) }}
                        {% else %}
                            Never
                        {% endif %}
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="form__actions">
        <a href="{{ url_for('transfers.index') }}" class="btn">Share more files</a>
    </div>

    <script>
        (function() {
            const btn = document.getElementById('copy-btn');
            const urlInput = document.getElementById('link-url');
            if (!btn || !urlInput) return;

            function copy() {
                const text = urlInput.value;
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(text).then(onCopied).catch(fallback);
                } else {
                    fallback();
                }
            }

            function fallback() {
                urlInput.select();
                urlInput.setSelectionRange(0, 99999);
                var ok = false;
                try {
                    ok = document.execCommand('copy');
                } catch (_) {}
                if (ok) {
                    onCopied();
                } else {
                    window.toast("Couldn't copy the link. Copy it from the field instead.", {
                        type: 'danger'
                    });
                }
            }

            function onCopied() {
                window.toast('Link copied.', {
                    type: 'success'
                });
            }

            btn.addEventListener('click', copy);
        })();
    </script>
{% endblock %}
