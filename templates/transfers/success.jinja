{% extends "site_base.jinja" %}

{% from "_macros.jinja" import icon, steps %}

{% block title %}Ready to share{% endblock %}

{% block content %}
    <div class="page-head">
        <div>
            <h1>Ready to share</h1>
            <p class="lead">
                {% if transfer.recipient_email %}
                    Link sent to {{ transfer.recipient_email }}.
                {% else %}
                    Copy the link below and share it with anyone.
                {% endif %}
            </p>
        </div>
    </div>

    {{ steps(4) }}

    <div class="link-group">
        <input type="text"
               class="field__control"
               id="link-url"
               value="{{ download_url }}"
               readonly
               aria-label="Shareable download link" />
        <button type="button" class="button" id="copy-btn">
            {{ icon("copy") }} <span>Copy link</span>
        </button>
    </div>

    <dl class="data-list data-list--rows">
        <div>
            <dt>Files</dt>
            <dd>
                {{ transfer.files | length }}
            </dd>
        </div>
        <div>
            <dt>Size</dt>
            <dd>
                {{ transfer.total_size | filesize }}
            </dd>
        </div>
        <div>
            <dt>Expires</dt>
            <dd>
                {% if transfer.expires_at %}
                    {{ transfer.expires_at | strftime }}
                {% else %}
                    Never
                {% endif %}
            </dd>
        </div>
    </dl>

    <div class="form__actions">
        <a href="{{ url_for('transfers.index') }}" class="button button--ghost">{{ icon("plus") }} Share more files</a>
    </div>

    <script>
        (function() {
            const btn = document.getElementById('copy-btn');
            const urlInput = document.getElementById('link-url');
            const label = btn.querySelector('span');
            if (!btn || !urlInput) return;

            function copy() {
                const text = urlInput.value;
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(text).then(onCopied).catch(fallback);
                } else {
                    fallback();
                }
            }

            function fallback() {
                urlInput.select();
                urlInput.setSelectionRange(0, 99999);
                try {
                    document.execCommand('copy');
                } catch (_) {}
                onCopied();
            }

            function onCopied() {
                label.textContent = 'Copied';
                setTimeout(function() {
                    label.textContent = 'Copy link';
                }, 2500);
            }

            btn.addEventListener('click', copy);
        })();
    </script>
{% endblock %}
