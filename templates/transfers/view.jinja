{% extends "site_base.jinja" %}

{% from "_macros.jinja" import icon %}

{% block title %}Download files{% endblock %}

{% block content %}
    {% if transfer.is_expired %}
        <div class="empty empty--framed">
            {{ icon('clock', 'empty__icon') }}
            <p class="empty__title">Transfer expired</p>
            <p class="empty__text">The files are no longer available.</p>
            <div class="empty__actions">
                <a href="{{ url_for('transfers.index') }}" class="button">{{ icon("bird") }} Share your own files</a>
            </div>
        </div>
    {% else %}
        {% set file_count = transfer.files | length %}
        <div class="page-head">
            <div>
                <h1>{{ file_count }} {{ "file" if file_count == 1 else "files" }}</h1>
                <p class="lead">
                    Shared
                    <time datetime="{{ transfer.created_at.isoformat() }}">{{ transfer.created_at | strftime }}</time>
                    {%- if transfer.expires_at %}, expires {{ transfer.expires_at | strftime }}{% endif %}
                </p>
            </div>
        </div>

        {% if transfer.message %}
            <blockquote>
                {{ transfer.message }}
            </blockquote>
        {% endif %}

        <ul class="download-list">
            {% for f in transfer.files %}
                <li class="download-list__item">
                    {{ icon(f.mime_type | file_icon, "download-list__icon") }}
                    <span class="download-list__info">
                        <strong class="download-list__name">{{ f.filename }}</strong>
                        <span class="download-list__size">{{ f.size | filesize }}</span>
                    </span>
                    <a href="{{ url_for('transfers.download_file', transfer_id=transfer.id, file_id=f.id) }}"
                       class="button button--sm"
                       download>{{ icon("download") }} Download</a>
                </li>
            {% endfor %}
        </ul>

        {% if file_count > 1 %}
            <div class="form__actions form__actions--split">
                <a href="{{ url_for('transfers.download_archive', transfer_id=transfer.id) }}"
                   class="button">{{ icon("download") }} Download all as zip</a>
                <span class="download-list__total">{{ transfer.total_size | filesize }} total</span>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
