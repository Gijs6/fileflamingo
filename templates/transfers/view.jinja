{% extends "site_base.jinja" %}

{% from "_macros.jinja" import when %}

{% block title %}Download files{% endblock %}

{% block content %}
    {% set file_count = transfer.files | length %}
    <div class="page-head">
        <h1>{{ file_count }} {{ "file" if file_count == 1 else "files" }}</h1>
    </div>

    <div class="table-wrap">
        <table class="table table--kv table--fit">
            <caption class="visually-hidden">Details</caption>
            <tbody>
                <tr>
                    <th scope="row">Shared</th>
                    <td>{{ when(transfer.created_at) }}</td>
                    {% if transfer.expires_at %}<th scope="row">Expires</th><td>{{ when(transfer.expires_at) }}</td>{% endif %}
                </tr>
            </tbody>
        </table>
    </div>

    {% if transfer.message %}
        <blockquote class="transfer-message">{{ transfer.message }}</blockquote>
    {% endif %}

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">File</th>
                    <th scope="col" class="table__num">Size</th>
                    <th scope="col" class="table__actions">
                        <span class="visually-hidden">Actions</span>
                    </th>
                </tr>
            </thead>
            <tbody>
                {% for f in transfer.files %}
                    <tr>
                        <td class="file-table__name">{{ f.filename }}</td>
                        <td class="table__num">{{ f.size | filesize }}</td>
                        <td class="table__actions">
                            <a href="{{ url_for('transfers.download_file', transfer_id=transfer.id, file_id=f.id) }}"
                               class="btn btn--sm"
                               download>Download</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
            {% if file_count > 1 %}
                <tfoot>
                    <tr>
                        <th scope="row">Total</th>
                        <td class="table__num">{{ transfer.total_size | filesize }}</td>
                        <td class="table__actions">
                            <a href="{{ url_for('transfers.download_archive', transfer_id=transfer.id) }}"
                               class="btn btn--sm">Download all as zip</a>
                        </td>
                    </tr>
                </tfoot>
            {% endif %}
        </table>
    </div>
{% endblock %}
