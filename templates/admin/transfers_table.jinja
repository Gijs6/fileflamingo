{% from "_macros.jinja" import when %}
<div class="table-wrap">
    <table class="table table--kv table--fit">
        <caption class="visually-hidden">Summary</caption>
        <tbody>
            <tr>
                <th scope="row">Transfers</th>
                <td>{{ transfers | length }}</td>
                <th scope="row">Files</th>
                <td>{{ total_files }}</td>
                <th scope="row">Storage</th>
                <td>{{ total_size | filesize }}</td>
                <th scope="row">Expired</th>
                <td>{{ expired_count }}</td>
            </tr>
        </tbody>
    </table>
</div>

{% if transfers %}
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col" class="table__num">Files</th>
                    <th scope="col" class="table__num">Size</th>
                    <th scope="col" class="table__num">Downloads</th>
                    <th scope="col">Created</th>
                    <th scope="col">Expires</th>
                    <th scope="col" class="table__actions">
                        <span class="visually-hidden">Actions</span>
                    </th>
                </tr>
            </thead>
            <tbody>
                {% for label, items in sections %}
                    <tr class="table__group">
                        <th colspan="7" scope="colgroup">
                            {{ label }} <span class="count">{{ "{:,}".format(items | length) }}</span>
                        </th>
                    </tr>
                    {% for transfer in items %}
                        <tr>
                            <td>
                                {% if transfer.status == "ready" and not transfer.is_expired %}
                                    <a href="{{ url_for('transfers.view', transfer_id=transfer.id) }}"
                                       target="_blank"
                                       rel="noopener noreferrer"><code>{{ transfer.id }}</code></a>
                                {% else %}
                                    <code>{{ transfer.id }}</code>
                                {% endif %}
                                {% if transfer.recipient_email %}
                                    <span class="status tooltip"
                                          tabindex="0"
                                          data-tooltip="Sent to {{ transfer.recipient_email }}">(emailed)</span>
                                {% endif %}
                            </td>
                            <td class="table__num">{{ transfer.files | length }}</td>
                            <td class="table__num">{{ transfer.total_size | filesize }}</td>
                            <td class="table__num">{{ transfer.download_count }}</td>
                            <td>{{ when(transfer.created_at) }}</td>
                            <td>
                                {% if transfer.expires_at %}
                                    {{ when(transfer.expires_at) }}
                                {% elif transfer.status != "pending" %}
                                    Never
                                {% endif %}
                            </td>
                            <td class="table__actions">
                                <button type="button"
                                        class="btn btn--danger btn--sm"
                                        hx-delete="{{ url_for('admin.delete_transfer', transfer_id=transfer.id) }}"
                                        hx-confirm="Delete transfer {{ transfer.id }}? Its files are deleted too."
                                        data-confirm-action="Delete transfer"
                                        hx-target="closest tr"
                                        hx-swap="outerHTML"
                                        hx-on::after-request="htmx.trigger('body', 'transfers-changed')">Delete</button>
                            </td>
                        </tr>
                    {% endfor %}
                {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <div class="empty">
        <p class="empty__title">No transfers yet</p>
    </div>
{% endif %}
