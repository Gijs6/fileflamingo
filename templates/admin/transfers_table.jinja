<div class="table-wrap">
    <table class="table table--kv" aria-label="Summary">
        <tbody>
            <tr>
                <th scope="row">Transfers</th>
                <td>{{ transfers | length }}</td>
                <th scope="row">Files</th>
                <td>{{ total_files }}</td>
                <th scope="row">Storage</th>
                <td>{{ total_size | filesize }}</td>
                <th scope="row">Expired</th>
                <td>{{ transfers | selectattr("is_expired") | list | length }}</td>
            </tr>
        </tbody>
    </table>
</div>

{% if transfers %}
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col" class="table__num">Files</th>
                    <th scope="col" class="table__num">Size</th>
                    <th scope="col" class="table__num">Downloads</th>
                    <th scope="col">Created</th>
                    <th scope="col">Expires</th>
                    <th scope="col" class="table__actions">
                        <span class="visually-hidden">Actions</span>
                    </th>
                </tr>
            </thead>
            <tbody>
                {% for transfer in transfers %}
                    <tr class="{% if transfer.is_expired %}transfer-row--expired{% elif transfer.status == 'pending' %}transfer-row--pending{% endif %}">
                        <td>
                            {% if transfer.status == "ready" %}
                                <a href="{{ url_for('transfers.view', transfer_id=transfer.id) }}"
                                   target="_blank"><code>{{ transfer.id }}</code></a>
                            {% else %}
                                <code>{{ transfer.id }}</code>
                            {% endif %}
                            {% if transfer.recipient_email %}
                                <span class="muted tooltip" tabindex="0" data-tooltip="Sent to {{ transfer.recipient_email }}">(emailed)</span>
                            {% endif %}
                        </td>
                        <td class="table__num">{{ transfer.files | length }}</td>
                        <td class="table__num">{{ transfer.total_size | filesize }}</td>
                        <td class="table__num">{{ transfer.download_count }}</td>
                        <td>
                            <time datetime="{{ transfer.created_at.isoformat() }}">{{ transfer.created_at | strftime }}</time>
                        </td>
                        <td>
                            {% if transfer.expires_at %}
                                {% if transfer.is_expired %}
                                    <span class="status status--warn">Expired</span>
                                {% else %}
                                    {{ transfer.expires_at | strftime }}
                                {% endif %}
                            {% elif transfer.status == "pending" %}
                                <span class="status">Pending</span>
                            {% else %}
                                <span class="muted">Never</span>
                            {% endif %}
                        </td>
                        <td class="table__actions">
                            <button type="button"
                                    class="btn btn--danger btn--sm"
                                    hx-delete="{{ url_for('admin.delete_transfer', transfer_id=transfer.id) }}"
                                    hx-confirm="Delete this transfer and all its files?"
                                    hx-target="closest tr"
                                    hx-swap="outerHTML"
                                    hx-on::after-request="htmx.trigger('body', 'transfers-changed')">Delete</button>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <div class="empty">
        <p class="empty__title">No transfers yet</p>
        <p>Transfers people create will show up here.</p>
    </div>
{% endif %}
