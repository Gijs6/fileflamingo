{% from "_macros.jinja" import icon %}
{% if transfers %}
    <div class="table-wrap">
        <table class="table table--rows table--hover">
            <thead>
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col" class="num">Files</th>
                    <th scope="col" class="num">Size</th>
                    <th scope="col" class="num">Downloads</th>
                    <th scope="col">Created</th>
                    <th scope="col">Expires</th>
                    <th scope="col">
                        <span class="visually-hidden">Actions</span>
                    </th>
                </tr>
            </thead>
            <tbody>
                {% for transfer in transfers %}
                    <tr class="{% if transfer.is_expired %}transfer-row--expired{% elif transfer.status == 'pending' %}transfer-row--pending{% endif %}">
                        <td>
                            {% if transfer.status == "ready" %}
                                <a class="id"
                                   href="{{ url_for('transfers.view', transfer_id=transfer.id) }}"
                                   target="_blank">{{ transfer.id }}{{ icon("external-link") }}</a>
                            {% else %}
                                <span class="id">{{ transfer.id }}</span>
                            {% endif %}
                        </td>
                        <td class="num">
                            <span class="files-count">
                                {{ transfer.files | length }}
                                {% if transfer.recipient_email %}<span class="tooltip" data-tooltip="Sent to {{ transfer.recipient_email }}">{{ icon("mail") }}</span>{% endif %}
                            </span>
                        </td>
                        <td class="num">{{ transfer.total_size | filesize }}</td>
                        <td class="num">{{ transfer.download_count }}</td>
                        <td>
                            <time datetime="{{ transfer.created_at.isoformat() }}">{{ transfer.created_at | strftime("%d %b %Y, %H:%M") }}</time>
                        </td>
                        <td>
                            {% if transfer.expires_at %}
                                {% if transfer.is_expired %}
                                    <span class="badge badge--warn">Expired</span>
                                {% else %}
                                    {{ transfer.expires_at | strftime }}
                                {% endif %}
                            {% elif transfer.status == "pending" %}
                                <span class="badge">Pending</span>
                            {% else %}
                                <span class="faint">Never</span>
                            {% endif %}
                        </td>
                        <td class="actions">
                            <button type="button"
                                    class="button button--danger button--sm"
                                    hx-delete="{{ url_for('admin.delete_transfer', transfer_id=transfer.id) }}"
                                    hx-confirm="Delete this transfer and all its files?"
                                    hx-target="closest tr"
                                    hx-swap="outerHTML swap:200ms">{{ icon("trash-2") }} Delete</button>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <div class="empty empty--framed">
        {{ icon('bird', 'empty__icon') }}
        <p class="empty__title">No transfers yet</p>
        <p class="empty__text">Transfers people create will show up here.</p>
    </div>
{% endif %}
